# Backend API
PORT=3000
NODE_ENV=development
# Em produção, use um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/barbearia.sqlite
CORS_ORIGIN=*
APP_TIME_ZONE=America/Sao_Paulo

# URL acessível pelo dispositivo/emulador Expo (substitua pelo IP LAN do computador).
# Android Emulator: http://10.0.2.2:3000/api
# iOS Simulator/Web local: http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
